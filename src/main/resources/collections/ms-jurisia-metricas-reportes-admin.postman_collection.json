{
  "info": {
    "_postman_id": "f0c12250-5037-4fb4-91ee-18ae49660b00",
    "name": "ms-jurisia-metricas - Reportes Admin",
    "description": "Reportes de administrador de ms-jurisia-metricas: calificaciones, sentencias y documentos generados por plantilla. Ver ENDPOINTS_Reportes_Admin_Metricas.md. Para llamar directo al microservicio (sin gateway) cambie gwMetricas a http://localhost:8013.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Autenticación",
      "item": [
        {
          "name": "Login (guarda token y sessionId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r && r.user) {",
                  "    pm.collectionVariables.set('sessionId', r.user.userSessionsId);",
                  "    if (r.user.token) pm.collectionVariables.set('token', r.user.token.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<usuario>\",\n  \"password\": \"<clave>\",\n  \"grantType\": \"password\",\n  \"clientId\": \"<clientId>\",\n  \"clientSecret\": \"<clientSecret>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gwSecurity}}/v1/auth/login",
              "host": [
                "{{gwSecurity}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login en ms-jurisia-security. Guarda sessionId (user.userSessionsId) y token (user.token.access_token) en variables de colección."
          },
          "response": []
        }
      ]
    },
